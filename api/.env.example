# Copy to `.env` (never commit that file) and fill in the values.
# On Render, set the same names under Environment. Nothing here is ever sent to the browser.

# ---- App -------------------------------------------------------------------------------
APP_ENV=development              # development | production | test
LOG_LEVEL=INFO
# LOG_JSON=true                  # default: JSON lines in production, readable text otherwise
ENABLE_DOCS=true                 # /docs (Swagger). Set false if you do not want it public
OWNER_NAME="Manjeet Singh"       # the name the assistant talks about
OWNER_PRONOUN=he                 # he | she | they: how the assistant refers to the owner

# ---- Database: Neon PostgreSQL ----------------------------------------------------------
# Paste the connection string from the Neon dashboard as it is (postgresql://...?sslmode=require).
# The app converts it for the async driver. pgvector is built into Neon; the migration
# enables it. Use the direct (non-"-pooler") host for `alembic upgrade`; either works for the app.
DATABASE_URL=

# ---- Chat model ------------------------------------------------------------------------
# anthropic | openai | groq | gemini | mock   (mock = offline, no key, for local development)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional. Defaults: anthropic claude-opus-5-5, openai gpt-4o-mini, groq llama-3.3-70b-versatile,
# gemini gemini-2.0-flash. Model names change: check your provider's docs.
# For lower cost on Anthropic, a smaller Claude model such as claude-haiku-5-5 also works.
# LLM_MODEL=
# LLM_BASE_URL=                  # a proxy, or any OpenAI-compatible service
# A cheaper model of the SAME provider, used only to rewrite follow-up questions before searching
# (for example claude-haiku-5-5). Unset = the main model.
# LLM_CONDENSE_MODEL=
LLM_MAX_TOKENS=700
# Anthropic only. low is right for short answers. Leave empty for Claude models without `effort`.
LLM_EFFORT=low
# OpenAI-compatible providers only. Leave unset unless you need it (some models reject it).
# LLM_TEMPERATURE=
# Anthropic only: re-run on a fallback model if the first one declines a request.
ANTHROPIC_REFUSAL_FALLBACK=true

# ---- Embeddings ------------------------------------------------------------------------
# openai | gemini | local | hash
#   local = a real model run on this machine, no API key (needs: pip install -r requirements-local.txt,
#           e.g. EMBEDDING_MODEL=BAAI/bge-small-en-v1.5 with EMBEDDING_DIM=384)
#   hash  = offline stand-in for development; it only matches shared words, no meaning
# Anthropic has no embedding model, so with LLM_PROVIDER=anthropic pick openai or gemini here
# and give it its own key below.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# MUST equal the size of the database column, which is fixed when the migration runs.
# Changing it later means a new migration and re-running the ingest script.
EMBEDDING_DIM=1536
# Not needed when EMBEDDING_PROVIDER is the same as LLM_PROVIDER (the LLM key is reused).
EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# ---- Web -------------------------------------------------------------------------------
# Sites allowed to call this API from a browser, comma separated, no trailing slash.
ALLOWED_ORIGINS=http://localhost:3000
# Turn on behind Render/Vercel/nginx so visitors are told apart by their real IP.
# Leave off if the API is reachable directly (the header could then be faked).
TRUST_PROXY_HEADERS=false
# Messages allowed per window: one IP, and one conversation (session id). Sliding window, in seconds.
CHAT_RATE_LIMIT_IP=20
CHAT_RATE_LIMIT_SESSION=12
CHAT_RATE_WINDOW_SECONDS=600
# A whole answer (retrieval + model) must finish within this time.
CHAT_TIMEOUT_SECONDS=45
# Optional. When set, requests must send it as the X-API-Key header. It ships inside the web
# bundle, so it only keeps out casual scripts. Leave empty to skip the check.
CHAT_API_KEY=
CHAT_HISTORY_TURNS=6
# Secret used to hash visitor IPs before they are stored. Use a long random value in production.
IP_HASH_SALT=change-me

# ---- Retrieval -------------------------------------------------------------------------
RAG_TOP_K=5
# Cosine distance (0 = identical). Passages farther than this are ignored; if none are close
# enough the assistant says it does not have that information, without calling the model.
# The right value depends on the embedding model. TUNE IT: run `python -m scripts.ask --samples
# --retrieval-only` and pick a value between your relevant questions' distances and the off-topic one's.
# Measured with BAAI/bge-small-en-v1.5: relevant 0.2-0.5, off-topic 0.6+, so about 0.55.
RAG_MAX_DISTANCE=0.75
# MMR keeps the top passages varied instead of near-copies of one paragraph.
RAG_USE_MMR=true
RAG_FETCH_K=20
RAG_MMR_LAMBDA=0.7
