# Copy this file to `.env.local` (never commit that one) and fill in the values.
# On Vercel, add the same names under Project Settings > Environment Variables.
# These are read only on the server (the /api/contact route): they are never sent to the browser.

# Contact form -> email, sent through Resend (https://resend.com)
RESEND_API_KEY=
# Where messages from the contact form should arrive
CONTACT_TO_EMAIL=

# Optional. The "from" address. Until you verify your own domain in Resend, leave this out
# (it then uses onboarding@resend.dev, which Resend only delivers to your own account email).
# CONTACT_FROM_EMAIL="Portfolio contact <contact@your-domain.com>"

# Optional. Public address of the site, for canonical and share-card URLs.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
